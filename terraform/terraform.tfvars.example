# Terraform Variables Example
# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git (it contains secrets)

# AWS Region
aws_region = "us-east-1"

# Project Configuration
project_name = "school-safety"
environment  = "production"

# Database Password (KEEP THIS SECRET!)
# Generate a strong password: https://passwordsgenerator.net/
db_password = "CHANGE_ME_TO_STRONG_PASSWORD"

# GitHub Configuration (for AWS Amplify)
github_repo  = "jatinbhagat/school-safety-app"
github_token = "CHANGE_ME_TO_GITHUB_PERSONAL_ACCESS_TOKEN"

# To create a GitHub token:
# 1. Go to GitHub Settings → Developer settings → Personal access tokens
# 2. Generate new token with 'repo' scope
# 3. Copy the token here
