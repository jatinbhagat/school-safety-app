# AWS Production Environment Variables Template
# Copy this file and fill in your actual values

# ============================================
# DATABASE (AWS RDS PostgreSQL)
# ============================================
# Get this from AWS RDS Console after creating your database
# Format: postgresql://USERNAME:PASSWORD@ENDPOINT:5432/DATABASE_NAME
DATABASE_URL=postgresql://postgres:YOUR_RDS_PASSWORD@your-db.xxxxx.us-east-1.rds.amazonaws.com:5432/school_safety

# ============================================
# AWS S3 FILE STORAGE
# ============================================
# Your S3 bucket name (must be globally unique)
S3_BUCKET=school-safety-uploads-YOUR_UNIQUE_ID
AWS_REGION=us-east-1

# AWS Credentials (create in IAM Console)
# NOT RECOMMENDED: Use IAM roles instead when possible
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# ============================================
# BACKEND API SETTINGS
# ============================================
PORT=8080
NODE_ENV=production

# CORS - Add your PWA domain here
CORS_ORIGIN=https://main.xxxxx.amplifyapp.com

# ============================================
# PWA (FRONTEND) SETTINGS
# ============================================
# Backend API URL from Elastic Beanstalk
NEXT_PUBLIC_API_URL=http://school-safety-backend.xxxxx.elasticbeanstalk.com

# ============================================
# OPTIONAL: CUSTOM DOMAINS
# ============================================
# If you set up custom domains, update these:
# NEXT_PUBLIC_API_URL=https://api.safelynotify.com
# CORS_ORIGIN=https://app.safelynotify.com

# ============================================
# SECURITY (RECOMMENDED)
# ============================================
# Generate a random secret key for JWT tokens
JWT_SECRET=your_very_long_random_secret_key_here

# Session secret for express-session
SESSION_SECRET=another_very_long_random_secret_key_here

# ============================================
# MONITORING & LOGGING (OPTIONAL)
# ============================================
# LOG_LEVEL=info
# SENTRY_DSN=your_sentry_dsn_for_error_tracking

# ============================================
# EMAIL (OPTIONAL - for notifications)
# ============================================
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your_ses_smtp_user
# SMTP_PASSWORD=your_ses_smtp_password
# FROM_EMAIL=noreply@safelynotify.com
