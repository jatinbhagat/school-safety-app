# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/school_safety

# Server
PORT=3001
NODE_ENV=development

# ==========================================
# SafelyNotify.com - New Configuration
# ==========================================

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Email (AWS SES - Legacy)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-ses-smtp-username
SMTP_PASS=your-ses-smtp-password
FROM_EMAIL=noreply@safelynotify.com

# SendGrid Email Service (Phase 3 - Reporter Notifications)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@safelynotify.com
SENDGRID_FROM_NAME=School Safety Alert

# Twilio SMS Service (Phase 3 - Reporter Notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+15555555555

# Application URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# AWS S3 (for logo uploads, QR codes, and attachments)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET=safelynotify-assets
CDN_URL=https://safelynotify-assets.s3.amazonaws.com

# ==========================================
# Legacy Configuration (for existing endpoints)
# ==========================================

# Authentication tokens
ADMIN_TOKEN=your-admin-token-here
STAFF_TOKEN=your-staff-token-here

# S3/MinIO Configuration for file uploads (legacy)
S3_BUCKET_NAME=school-safety-attachments
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
PRESIGN_EXPIRES_IN=3600
